# ─── Server ──────────────────────────────────────────────────────
# Port the Express API listens on
PORT=3000

# ─── Database ────────────────────────────────────────────────────
# Path to the SQLite file (relative to server/)
DB_PATH=./db/salon.db

# ─── OpenAI (Milestone 3 — AI Message Drafting) ──────────────────
# Leave blank to run without AI. The app automatically falls back to deterministic templates.
OPENAI_API_KEY=
# Configurable model (defaults to gpt-4o-mini if unspecified)
OPENAI_MODEL=gpt-4o-mini
# Request timeout in milliseconds (defaults to 5000)
OPENAI_TIMEOUT_MS=5000

# ─── Frontend Dev Server ─────────────────────────────────────────
# Vite proxies /api calls to this origin during local development
VITE_API_BASE_URL=http://localhost:3000
