# ─── Server Configuration ──────────────────────────────────────────
# Port the Express API listens on (Render automatically provides PORT in production)
PORT=3000
# Host to bind to (defaults to 0.0.0.0 for container / cloud deployment)
HOST=0.0.0.0
# Environment mode: 'development' or 'production' (masks 500 error details in production)
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────
# Path to the SQLite file (relative to server/)
DB_PATH=./db/salon.db

# ─── CORS Configuration (Backend) ────────────────────────────────────
# Dedicated comma-separated allowlist of origins allowed to access the backend API.
# In local development: defaults to http://localhost:5173,http://127.0.0.1:5173
# On Render: set to your deployed frontend URL (e.g. https://salon-frontend.onrender.com)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ─── OpenAI Configuration (Backend Only) ─────────────────────────────
# OpenAI API key configured strictly on the backend. Never expose in frontend code.
# Leave blank to run without AI. The app automatically falls back to deterministic templates.
OPENAI_API_KEY=
# Configurable model (defaults to gpt-4o-mini if unspecified)
OPENAI_MODEL=gpt-4o-mini
# Request timeout in milliseconds (defaults to 5000)
OPENAI_TIMEOUT_MS=5000

# ─── Frontend Configuration (Client Static Site) ─────────────────────
# Base URL of the backend API for production static hosting.
# In local development: leave blank to leverage the Vite proxy (/api -> http://localhost:3000).
# On Render Static Site: set to your deployed backend URL (e.g. https://salon-api.onrender.com).
VITE_API_BASE_URL=
