# ─── Server ──────────────────────────────────────────────────────
# Port the Express API listens on
PORT=3000

# ─── Database ────────────────────────────────────────────────────
# Path to the SQLite file (relative to server/)
DB_PATH=./db/salon.db

# ─── OpenAI (Milestone 5 — not required until AI integration) ───
# Leave blank to run without AI. The app falls back to template-based offers.
OPENAI_API_KEY=

# ─── Frontend Dev Server ─────────────────────────────────────────
# Vite proxies /api calls to this origin during local development
VITE_API_BASE_URL=http://localhost:3000
